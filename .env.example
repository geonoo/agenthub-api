# Copy to .env and fill in real values before deploying
ENVIRONMENT=production
DEBUG=false
API_KEY=change-me-in-production
MASTER_API_KEY=change-me-master-key
CORS_ORIGINS=https://agenthub.co.kr,https://api.agenthub.co.kr
APP_VERSION=0.1.0

# Burst rate limit (per key)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Free-tier daily quota for self-issued keys
FREE_TIER_DAILY_LIMIT=1000

# SQLite (Docker volume ./data -> /app/data)
DATABASE_URL=sqlite:////app/data/agenthub.db

# Open DART API key (https://opendart.fss.or.kr/)
DART_API_KEY=

# Resend (https://resend.com) — email verification codes
RESEND_API_KEY=
EMAIL_FROM=AgentHub <auth@agenthub.co.kr>
EMAIL_CODE_TTL_MINUTES=5
